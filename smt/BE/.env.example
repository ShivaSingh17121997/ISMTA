# ISMTA backend configuration. Copy to .env and fill in what you use.
# Every value has a safe default for PAPER mode; the ones marked LIVE are
# required before BROKER is anything but paper.

# ── capital / broker / data ──────────────────────────────────────────
RISK_CAPITAL=200000            # paper pool, rupees
BROKER=paper                   # paper | zerodha | groww
DATA_SOURCE=yahoo              # yahoo | zerodha | sim (sim = synthetic, dev only)
PORT=4000
# MONGO_URI=mongodb://127.0.0.1:27017/smt_trading
MONGO_URI=mongodb+srv://shivasingh001997shiva:singh@cluster0.hndbz5b.mongodb.net/trading_bots

# ── security ─────────────────────────────────────────────────────────
# LIVE: the server refuses to start with a live broker on the default secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ── SEBI retail-algo framework (mandatory since 1 Apr 2026) ──────────
# LIVE: the public IP whitelisted at your broker. Checked at boot and every
# 10 minutes; a mismatch halts every order until it matches again.
BROKER_STATIC_IP=
MAX_ORDERS_PER_SECOND=10       # above this the algo must be registered with the exchange
MAX_ORDERS_PER_MINUTE=400      # Kite's limit
MAX_ORDERS_PER_DAY=5000        # Kite's limit

# ── pre-trade guards ─────────────────────────────────────────────────
MAX_QUOTE_AGE_MS=90000         # refuse an order when the symbol has not ticked for this long during the session
MAX_FILL_DEVIATION_PCT=2       # refuse when the live quote is this far from the price the decision was made at
RECONCILE_EVERY_MIN=5          # broker holdings vs books (live brokers only)
STRATEGY_BAR_MS=60000          # live strategy bar length; 60 s is the smallest real bar on the Yahoo feed

# ── alerts (Telegram) ────────────────────────────────────────────────
# Create a bot with @BotFather, send it a message, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Unset = alerts are logged only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Zerodha (BROKER=zerodha or DATA_SOURCE=zerodha) ──────────────────
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=          # from `npm run kite:login`, expires 06:00 IST daily
ZERODHA_MARKET_PROTECTION=-1   # Kite rejects 0 since 2026; -1 = broker picks the band

# ── per-user Zerodha connections (Settings → Zerodha) ────────────────
# Each user saves their own Kite api_key + api_secret, picks Free (Personal) or
# Paid (Kite Connect), connects once a day, and switches paper/live themselves.
# Keep BROKER=paper for this: BROKER=zerodha sends EVERY user to the .env account.
# Encrypts every saved API secret and daily token. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Lose it and saved keys must be re-entered.
BROKER_CREDENTIALS_KEY=
# The Redirect URL to register on developers.kite.trade is
# <PUBLIC_API_URL>/api/broker/zerodha/callback
PUBLIC_API_URL=http://127.0.0.1:4000
FRONTEND_URL=http://localhost:3000

# ── Groww (BROKER=groww) ─────────────────────────────────────────────
GROWW_API_KEY=
GROWW_TOTP_SECRET=             # the second factor itself: never commit this

# ── session (IST) ────────────────────────────────────────────────────
SESSION_ENABLED=true
SESSION_ENTRY_OPENS_AT=09:20
SESSION_ENTRY_CLOSES_AT=15:00
SESSION_FLATTEN_AT=15:10
SESSION_SQUARE_OFF_AT=15:25
# NSE_HOLIDAYS=2027-01-26,2027-03-22   # override the built-in 2026 list next January

# ── risk gate (strategy engine) ──────────────────────────────────────
# These gate the STRATEGY engine only. The accumulator has its own controls
# (per-lot breakeven floor, budget, deployment ceiling, reserve, kill switch)
# and does not pass this gate.
#
# The two rupee limits are DERIVED FROM RISK_CAPITAL when left unset:
#     RISK_MAX_POSITION_VALUE  = 10%  of capital
#     RISK_DAILY_LOSS_LIMIT    = 0.5% of capital
# Leave them commented out and they follow the account. They used to be listed
# here as absolute figures chosen for a 10,00,000 account — at RISK_CAPITAL=200000
# that permitted half the account in one position and 250% of capital across
# five, which is how a small account inherited a large account's risk.
#
# Uncomment only to override deliberately, and re-check them when capital changes.
# RISK_DAILY_LOSS_LIMIT=1000
# RISK_MAX_POSITION_VALUE=20000
RISK_MAX_POSITIONS=5
MAX_CONSECUTIVE_LOSSES=3

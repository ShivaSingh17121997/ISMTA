    "verify:turbulence": "ts-node --transpile-only src/scripts/verifyTurbulence.ts",
    "start:supervised": "node scripts/supervise.js",
    "totp:reset": "ts-node --transpile-only src/scripts/resetTotp.ts",
    "calibrate:weather": "ts-node --transpile-only src/scripts/calibrateWeather.ts",
    "verify:weather": "ts-node --transpile-only src/scripts/verifyWeather.ts",
    "backrun:weather": "ts-node --transpile-only src/scripts/backrunWeather.ts",
    "verify:global": "ts-node --transpile-only src/scripts/verifyGlobal.ts",
    "verify:foreign": "ts-node --transpile-only src/scripts/verifyForeign.ts"

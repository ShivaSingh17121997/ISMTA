{
  "name": "be",
  "version": "1.0.0",
  "description": "Automated trading platform backend (Indian stock market) — paper-trading MVP",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "kite:login": "ts-node-dev --transpile-only src/scripts/kiteLogin.ts",
    "seed:demo": "ts-node --transpile-only src/scripts/seedUser.ts",
    "test": "node scripts/run-tests.js",
    "verify:feed": "ts-node --transpile-only src/scripts/verifyYahooFeed.ts",
